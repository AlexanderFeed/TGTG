# Public port on the VPS. Change this if port 3000 is already occupied.
WEB_PORT=3000

# API is bound to VPS loopback only. Browsers use the Nuxt /api proxy.
API_PORT=8080

# Optional image tag, useful for identifiable releases and rollbacks.
APP_VERSION=latest

# PostgreSQL running directly on the VPS. URL-encode special characters in the
# password. Prefer sslmode=require for a remote database connection.
DATABASE_URL=postgres://eshche_est:CHANGE_ME@host.docker.internal:5432/eshche_est?sslmode=disable
MIGRATE_ON_START=true

# Generate with: openssl rand -hex 32
OTP_PEPPER=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
OTP_EXPIRY=10m
OTP_COOLDOWN=1m
OTP_MAX_ATTEMPTS=5
SESSION_TTL=720h

# false is needed for an http://IP:3000 preview. Change to true behind HTTPS.
SESSION_COOKIE_SECURE=false

# SMTP mode verifies ownership by sending the real six-digit email code.
# Port 587 with STARTTLS is supported.
EMAIL_DELIVERY=smtp
EXPOSE_DEV_CODES=false
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_USER=mailer@example.ru
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=ЕщёЕсть <mailer@example.ru>

# Accounts registered with these emails receive admin offer-CRUD permission.
ADMIN_EMAILS=you@example.ru

# Local-only alternative without SMTP (never use this for a public preview):
# EMAIL_DELIVERY=development
# EXPOSE_DEV_CODES=true
